---
eleventyExcludeFromCollections: true
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
  {% unless item.url contains '/assets/' or item.url contains '/_utilities/' or item.url == '/404/' or item.url == '/blog/' %}
  {% if item.data.noindex != false %}
  <url>
    <loc>{{ env.baseUrl }}{{ item.url }}</loc>
  </url>
  {% endif %}
  {% endunless %}
{% endfor %}
</urlset>
